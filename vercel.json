{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/ludoserver.js": {
      "runtime": "nodejs24.x",
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/api/ludoserver",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
