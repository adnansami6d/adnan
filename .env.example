# Copy these names into Vercel -> Project -> Settings -> Environment Variables.
# Do NOT put real values in this file. Do NOT commit a real .env.local to GitHub.

# ---- Supabase (public: safe in the browser, protected by RLS) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Supabase (SECRET: server only, never add NEXT_PUBLIC_ in front) ----
# Supabase dashboard -> Project Settings -> API Keys -> "secret" / service_role key.
# Used only by API routes (e.g. marking a phone as verified after OTP).
SUPABASE_SERVICE_ROLE_KEY=

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# ---- Wallet top-up: numbers customers send money to (shown on the wallet page) ----
NEXT_PUBLIC_BKASH_NUMBER=
NEXT_PUBLIC_NAGAD_NUMBER=
NEXT_PUBLIC_ROCKET_NUMBER=

# ---- SMS gateway for OTP (SECRET: server only; fill in when a provider is chosen) ----
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
